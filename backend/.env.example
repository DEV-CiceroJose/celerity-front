# Copie para backend/.env. Este exemplo não contém credenciais.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# false: banco normal; true: habilita o painel local de dados fictícios.
CELERITY_LOCAL_TEST_MODE=false
# Em branco: db.sqlite3 no modo normal; .local-test/db.sqlite3 no modo de testes.
# Caminhos relativos são resolvidos a partir da pasta backend.
CELERITY_DB_PATH=
LICENSE_REMINDER_DAYS=60
CELERITY_FRONTEND_URL=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Para Brevo: altere o backend, preencha a chave e o remetente validado.
# EMAIL_BACKEND=celerity_reminders.brevo.BrevoEmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=

# Alternativa SMTP: configurações do seu provedor.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
